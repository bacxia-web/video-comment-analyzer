{
  "manifest_version": 3,
  "name": "Video & Comment Analyzer",
  "version": "0.2.7",
  "minimum_chrome_version": "116",
  "description": "YouTube 字幕翻译、中英对照和笔记；YouTube、哔哩哔哩视频摘要；YouTube、小红书、雪球评论分析。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "https://www.googleapis.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://xueqiu.com/*",
    "https://www.xueqiu.com/*"
  ],
  "action": {
    "default_title": "Video & Comment Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "preferences.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*",
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*",
        "https://xueqiu.com/*",
        "https://www.xueqiu.com/*"
      ],
      "js": ["platforms.js", "launcher.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
